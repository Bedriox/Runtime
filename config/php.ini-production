; Bedriox Runtime production configuration.
; Launchers must set BEDRIOX_RUNTIME_ROOT to this file's containing runtime.

[PHP]
engine = On
short_open_tag = Off
precision = 14
output_buffering = 4096
serialize_precision = -1
zend.exception_ignore_args = On
expose_php = Off
max_execution_time = 0
max_input_time = -1
memory_limit = -1
error_reporting = E_ALL
display_errors = Off
display_startup_errors = Off
log_errors = On
ignore_repeated_errors = Off
report_memleaks = On
variables_order = "GPCS"
request_order = "GP"
register_argc_argv = On
auto_globals_jit = On
enable_dl = Off
file_uploads = Off
allow_url_fopen = On
allow_url_include = Off
default_socket_timeout = 60
extension_dir = "${BEDRIOX_RUNTIME_ROOT}/ext"

[CLI Server]
cli_server.color = On

[Date]
date.timezone = UTC

[Phar]
phar.readonly = On
phar.require_hash = On

[OpenSSL]
openssl.cafile = "${BEDRIOX_RUNTIME_ROOT}/certs/cacert.pem"

[curl]
curl.cainfo = "${BEDRIOX_RUNTIME_ROOT}/certs/cacert.pem"

[opcache]
opcache.enable = On
opcache.enable_cli = On
opcache.jit = disable
opcache.validate_timestamps = On
opcache.revalidate_freq = 2

; The finalizer adds only extension modules that were actually built shared.
; Statically linked modules must not be loaded again.
@BEDRIOX_DYNAMIC_EXTENSIONS@
